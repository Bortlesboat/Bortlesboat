# This profile repo tracks public portfolio documents, reviewed contribution evidence, workflows, and profile cards.
# Local clone/release/worktree spillover belongs elsewhere and must not be staged here.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/case-studies.md
!/github-portfolio.md
!/github-contributions.md
!/oss-contributions.json
!/bitcoin-research/
!/bitcoin-research/**
!/.github/
!/.github/**
!/profile-summary-card-output/
!/profile-summary-card-output/**

# Disposable experiment wallets and private execution artifacts never belong here.
/bitcoin-research/**/secrets.json
/bitcoin-research/**/*.sqlite*
/bitcoin-research/**/exit-package.json
/bitcoin-research/**/.runs/
